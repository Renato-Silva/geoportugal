# Where fetched photos and orthophoto tiles are stored when S3 is not configured
# (relative to the working directory)
# NUXT_ARCHIVE_DIR=.data/archive

# Optional S3 or S3-compatible storage (AWS, Cloudflare R2, MinIO, Backblaze B2) instead of local disk
# NUXT_S3_BUCKET=
# NUXT_S3_REGION=            # "auto" for R2
# NUXT_S3_ENDPOINT=          # optional for AWS; required for R2/MinIO
# NUXT_S3_ACCESS_KEY_ID=
# NUXT_S3_SECRET_ACCESS_KEY=

# docker compose: published address/port of the app. Defaults to 127.0.0.1:3000 (behind a reverse proxy)
# APP_BIND=0.0.0.0
# APP_PORT=3000
